---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { whatsappUrl, MENSAJE_DIAGNOSTICO, WHATSAPP_DISPLAY } from '../config/whatsapp';

const contactoHref = whatsappUrl(MENSAJE_DIAGNOSTICO);
---

<section id="contacto" class="relative overflow-hidden py-24 px-4">
  <div class="max-w-xl mx-auto text-center mb-12">
    <div class="reveal inline-flex items-center gap-2 text-xs tracking-widest uppercase mb-4" style="color:var(--primary-l);">
      <span class="w-1.5 h-1.5 rounded-full bg-mist"></span>
      Contacto
    </div>
    <h2 class="reveal font-display font-bold mb-4" style="font-size:clamp(2rem, 5vw, 3.5rem); color:#F2F5FF;">
      Contanos sobre tu negocio.
    </h2>
    <p class="reveal" style="color:rgba(242,245,255,0.85);">
      Escribinos por WhatsApp y te respondemos personalmente para coordinar tu diagnóstico gratuito.
    </p>
  </div>

  <div class="reveal liquid-glass rounded-3xl p-6 md:p-10 max-w-xl mx-auto text-center">
    <a href={contactoHref} target="_blank" rel="noopener"
       class="w-full inline-flex items-center justify-center gap-2 bg-zafiro hover:bg-marino transition-colors text-white font-medium px-7 py-3.5 rounded-full shadow-[0_8px_30px_rgba(23,53,158,0.5)]">
      <WhatsAppIcon class="w-5 h-5" />
      Escribinos por WhatsApp
    </a>

    <p class="mt-6 text-sm" style="color:rgba(242,245,255,0.6);">
      O agendá nuestro número:
      <span class="block mt-1 font-display font-semibold text-lg tracking-wide select-all" style="color:#F2F5FF;">{WHATSAPP_DISPLAY}</span>
    </p>
  </div>
</section>
