---
const tools = [
  'WhatsApp',
  'Instagram',
  'Gmail',
  'Outlook',
  'Google Calendar',
  'Google Sheets',
  'Google Drive',
  'Excel',
  'Notion',
  'HubSpot',
  'Mercado Pago',
  'Tiendanube',
  'Shopify',
  'Slack',
  'Calendly',
];
---

<section class="relative overflow-hidden py-10">
  <div class="reveal text-center px-4 mb-6">
    <div class="inline-flex items-center gap-2 text-xs tracking-widest uppercase" style="color:var(--primary-l);">
      <span class="w-1.5 h-1.5 rounded-full bg-mist"></span>
      Se integra con las herramientas que ya usás
    </div>
  </div>
  <div class="marquee-track">
    {[0, 1].map((group) => (
      <div class="flex items-center shrink-0" aria-hidden={group === 1 ? 'true' : undefined}>
        {tools.map((tool) => (
          <>
            <span class="font-display font-semibold px-6" style="font-size:clamp(1.75rem, 4vw, 3rem); color:rgba(242,245,255,0.9);">{tool}</span>
            <span class="w-2.5 h-2.5 rounded-full bg-mist marquee-dot shrink-0"></span>
          </>
        ))}
      </div>
    ))}
  </div>
</section>
