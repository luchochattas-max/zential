---
const phrases = [
  'Un paso adelante hacia el futuro',
  'Diagnóstico real, no plantillas',
  'Un socio tecnológico, no un proveedor puntual',
  'Crecemos con tu negocio',
];
---

<section class="relative overflow-hidden py-10">
  <div class="marquee-track">
    {[0, 1].map((group) => (
      <div class="flex items-center shrink-0" aria-hidden={group === 1 ? 'true' : undefined}>
        {phrases.map((phrase) => (
          <>
            <span class="font-display font-semibold px-6" style="font-size:clamp(1.75rem, 4vw, 3rem); color:rgba(242,245,255,0.9);">{phrase}</span>
            <span class="w-2.5 h-2.5 rounded-full bg-mist glow-pulse shrink-0"></span>
          </>
        ))}
      </div>
    ))}
  </div>
</section>
