---
import { Image } from 'astro:assets';
import symbol from '../assets/logo/zential_simbolo_mono_blanco.png';
import wordmark from '../assets/logo/zential_wordmark_mono_blanco.png';
---

<section class="relative overflow-hidden pt-8 pb-10 px-4">
  <div class="max-w-3xl mx-auto text-center mb-16">
    <Image src={symbol} alt="" aria-hidden="true" class="glow-pulse h-20 md:h-24 w-auto mx-auto mb-8" />
    <h2 class="reveal font-display font-bold" style="font-size:clamp(2rem, 5.5vw, 3.75rem); color:#F2F5FF;">
      Un paso adelante hacia el futuro.
    </h2>
  </div>

  <div class="max-w-6xl mx-auto liquid-glass rounded-3xl px-6 md:px-10 py-6 flex flex-col md:flex-row items-center justify-between gap-4">
    <Image src={wordmark} alt="Zential" class="h-5 w-auto opacity-80" />
    <div class="text-xs text-center" style="color:rgba(242,245,255,0.6);">© 2026 Zential. Todos los derechos reservados.</div>
    <div class="flex items-center gap-5 text-xs" style="color:rgba(242,245,255,0.6);">
      <!-- REEMPLAZAR: enlaces legales definitivos -->
      <a href="#" class="hover:opacity-100 opacity-80 transition-opacity">Privacidad</a>
      <a href="#" class="hover:opacity-100 opacity-80 transition-opacity">Términos</a>
      <a href="https://instagram.com/zential.ai" target="_blank" rel="noopener" class="hover:opacity-100 opacity-80 transition-opacity">Instagram</a>
      <a href="mailto:zential.ai@gmail.com" class="hover:opacity-100 opacity-80 transition-opacity">Contacto</a>
    </div>
  </div>
</section>
