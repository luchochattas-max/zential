---
import { Check, ArrowRight } from '@lucide/astro';
import { whatsappUrl, mensajeServicio } from '../config/whatsapp';

interface Props {
  id?: string;
  reverse?: boolean;
  name: string;
  title: string;
  bullets: string[];
}

const { id, reverse = false, name, title, bullets } = Astro.props;
---

<div id={id} style="scroll-margin-top: 110px;" class:list={['reveal flex flex-col lg:items-center gap-10 lg:gap-16', reverse ? 'lg:flex-row-reverse' : 'lg:flex-row']}>
  <div class="w-full lg:w-1/2">
    <div class="inline-flex items-center gap-2 text-xs tracking-widest uppercase mb-3 font-medium" style="color:var(--primary-l);">
      <span class="w-1.5 h-1.5 rounded-full bg-mist"></span>
      {name}
    </div>
    <h3 class="font-display font-bold mb-4" style="font-size:clamp(1.5rem, 3vw, 2.25rem); color:#F2F5FF;">
      {title}
    </h3>
    <p class="mb-6" style="color:rgba(242,245,255,0.85);">
      <slot name="description" />
    </p>
    <ul class="space-y-3 mb-8">
      {bullets.map((bullet) => (
        <li class="flex items-start gap-3 text-sm" style="color:rgba(242,245,255,0.85);">
          <Check class="w-4 h-4 mt-0.5 shrink-0" style="color:var(--primary-l);" />
          {bullet}
        </li>
      ))}
    </ul>
    <a href={whatsappUrl(mensajeServicio(name))} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm font-medium" style="color:var(--primary-l);">
      Consultar por {name} <ArrowRight class="w-4 h-4" />
    </a>
  </div>
  <div class="w-full lg:w-1/2">
    <slot name="mockup" />
  </div>
</div>
