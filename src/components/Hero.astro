---
import { ArrowRight } from '@lucide/astro';
import { Image } from 'astro:assets';
import symbol from '../assets/logo/zential_simbolo_mono_blanco.png';

const diagnosticoHref = 'mailto:zential.ai@gmail.com?subject=Quiero%20agendar%20un%20diagn%C3%B3stico%20con%20Zential';
---

<header id="top" class="relative min-h-screen overflow-hidden flex flex-col items-center justify-center px-4 pt-32 pb-20">
  <canvas id="particles" class="absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true"></canvas>

  <div class="relative z-10 flex flex-col items-center text-center max-w-3xl mx-auto">
    <Image src={symbol} alt="" aria-hidden="true"
         class="hero-symbol-float glow-pulse h-28 md:h-36 w-auto mb-8" />

    <div class="inline-flex items-center gap-2 liquid-glass rounded-full px-4 py-1.5 mb-7 text-xs tracking-widest uppercase" style="color:#F2F5FF;">
      <span class="w-1.5 h-1.5 rounded-full bg-mist pulse-dot"></span>
      Inteligencia artificial para negocios
    </div>

    <h1 class="font-display font-bold leading-[1.05] mb-6" style="font-size:clamp(2.5rem, 7vw, 4.5rem); color:#F2F5FF;">
      Digitalizá tu negocio<br />
      antes que lo haga <span class="shiny-text">tu competencia.</span>
    </h1>

    <p class="mx-auto mb-10" style="max-width:620px; font-size:18px; color:rgba(242,245,255,0.85); font-weight:400;">
      Diagnosticamos tu negocio, desarrollamos la solución de inteligencia artificial que necesita y la implementamos de punta a punta. Cada sistema se construye a medida y se actualiza junto con tu operación. No vendemos paquetes genéricos ni funciones que no vas a usar.
    </p>

    <div class="flex flex-col sm:flex-row items-center gap-4">
      <a href={diagnosticoHref}
         class="inline-flex items-center gap-2 bg-zafiro hover:bg-marino transition-colors text-white font-medium px-7 py-3.5 rounded-full shadow-[0_8px_30px_rgba(23,53,158,0.5)]">
        Agendar diagnóstico gratuito
        <ArrowRight class="w-4 h-4" />
      </a>
      <a href="#proceso"
         class="liquid-glass-strong inline-flex items-center gap-2 text-white font-medium px-7 py-3.5 rounded-full">
        Ver cómo trabajamos
      </a>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 hidden sm:flex flex-col items-center gap-3" aria-hidden="true">
    <span class="text-[11px] tracking-widest uppercase" style="color:rgba(242,245,255,0.6);">Scroll</span>
    <div class="relative w-px h-14 bg-white/15 overflow-hidden rounded-full">
      <div class="scroll-line-highlight absolute top-0 left-0 w-full h-1/3 bg-gradient-to-b from-transparent via-mist to-transparent"></div>
    </div>
  </div>
</header>

<script src="../scripts/particles.ts"></script>
