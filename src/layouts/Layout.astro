---
import '../styles/global.css';
import favicon from '../assets/logo/zential_favicon_avatar.png';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Zential — Inteligencia artificial para negocios',
  description = 'Zential diagnostica tu negocio, desarrolla la solución de inteligencia artificial que necesita y la implementa de punta a punta. Un paso adelante hacia el futuro.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href={favicon.src} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body class="text-white font-body antialiased">
  <div class="page-video-overlay" aria-hidden="true"></div>
  <div class="global-blobs" aria-hidden="true">
    <div class="blob blob-a"></div>
    <div class="blob blob-b"></div>
    <div class="blob blob-c"></div>
    <div class="blob blob-d"></div>
    <div class="blob blob-e"></div>
  </div>

  <div class="cursor-glow" id="cursor-glow" aria-hidden="true"></div>
  <div class="cursor-dot" id="cursor-dot" aria-hidden="true"></div>

  <slot />

  <script src="../scripts/cursor.ts"></script>
  <script src="../scripts/nav.ts"></script>
  <script src="../scripts/reveal.ts"></script>
</body>
</html>
