# API key de Resend (https://resend.com/api-keys) — necesaria para que /api/contact pueda enviar mails.
RESEND_API_KEY=

# Remitente verificado en Resend. Mientras no se verifique un dominio propio,
# se puede dejar sin definir y usar el sandbox "onboarding@resend.dev" (con límites de envío).
CONTACT_FROM_EMAIL=
